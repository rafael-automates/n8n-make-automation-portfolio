    {
      "parameters": {
        "jsCode": "const norm = s => String(s ?? '').trim().toUpperCase().replace(/\\s+/g, '');\nconst field = (row, name) => {\n  for (const k of Object.keys(row)) {\n    if (k.trim().toLowerCase() === name.toLowerCase()) return row[k];\n  }\n  return undefined;\n};\n\nconst sheetRows = $('Invoices Sheet').all().map(i => i.json);\nconst bills = $('Xero Bills').all().map(i => i.json).filter(b => b.Type === 'ACCPAY');\n\nconst byNumber = {};\nfor (const b of bills) {\n  const key = norm(b.InvoiceNumber);\n  if (!key) continue;\n  (byNumber[key] = byNumber[key] || []).push(b);\n}\n\nconst out = [];\nfor (const r of sheetRows) {\n  const file = field(r, 'File');\n  const supplier = field(r, 'Supplier');\n  const number = field(r, 'Invoice Number');\n  const total = Number(field(r, 'Total'));\n  const matches = byNumber[norm(number)] || [];\n  let status, xeroTotal = '', diff = '', note = '';\n\n  if (!norm(number) || Number.isNaN(total)) {\n    status = 'REVIEW'; note = 'Missing invoice number or total in the extractor row';\n  } else if (matches.length === 0) {\n    status = 'NOT FOUND'; note = 'No bill with this invoice number in Xero';\n  } else if (matches.length > 1) {\n    status = 'REVIEW'; note = 'More than one Xero bill has this invoice number';\n  } else {\n    const b = matches[0];\n    xeroTotal = Number(b.Total);\n    diff = Math.round((total - xeroTotal) * 100) / 100;\n    status = Math.abs(diff) <= 0.01 ? 'MATCH' : 'MISMATCH';\n    if (norm(b.Contact && b.Contact.Name) !== norm(supplier)) {\n      note = 'Supplier name differs: ' + (b.Contact && b.Contact.Name);\n    }\n  }\n  out.push({ json: { file, supplier, invoice_number: number, invoice_total: total, xero_total: xeroTotal, difference: diff, status, note } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "id": "0cb87e28-a3c6-4677-abe5-5e4737450f3c",
      "name": "Compare"
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $input.all().map(i => i.json);\nconst count = s => rows.filter(r => r.status === s).length;\nconst lines = [`Xero check finished: ${count('MATCH')} match, ${count('MISMATCH')} mismatch, ${count('NOT FOUND')} not found, ${count('REVIEW')} need review.`];\nfor (const r of rows.filter(r => r.status === 'MISMATCH')) {\n  lines.push(`MISMATCH: ${esc(r.supplier)} ${esc(r.invoice_number)}: invoice ${r.invoice_total} vs Xero ${r.xero_total} (difference ${r.difference})`);\n}\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "type": "n8n-nodes-base.code",

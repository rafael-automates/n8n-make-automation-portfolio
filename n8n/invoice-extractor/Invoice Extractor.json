          "mode": "list",
          "cachedResultName": "models/gemini-3.5-flash-lite"
        },
        "text": "Extract this supplier invoice. Return ONLY valid JSON with no markdown and no explanation, using exactly this structure:\n{\"supplier\":\"\",\"invoice_number\":\"\",\"invoice_date\":\"YYYY-MM-DD\",\"currency\":\"GBP\",\"subtotal\":0,\"discount\":0,\"vat\":0,\"total\":0,\"line_items\":[{\"product_code\":\"\",\"product\":\"\",\"quantity\":0,\"unit_cost\":0,\"line_total\":0}]}\nRules: copy the figures printed on the invoice and do not calculate or correct them. Read dates as day/month/year. Use null for anything not visible. Write numbers without currency symbols or thousands separators. The discount is a positive number.",
        "inputType": "binary",
        "binaryPropertyName": "Invoice",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        256,
        -480
      ],
      "id": "54225c6a-290b-42f6-9be8-fae833dad4aa",
      "name": "Analyze document",
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.content.parts[0].text;\nconst fileName = $('On form submission').item.binary?.Invoice?.fileName ?? '';\nlet data;\nconst reasons = [];\n\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  return { json: { file: fileName, needs_review: true, review_reasons: 'Model output was not valid JSON', raw } };\n}\n\nconst num = v => (v === null || v === undefined || v === '' ? 0 : Number(v));\ndata.discount = num(data.discount);\ndata.vat = num(data.vat);\nconst lines = Array.isArray(data.line_items) ? data.line_items : [];\nif (!lines.length) reasons.push('No line items found');\n\nlet sum = 0;\nfor (const l of lines) {\n  const calc = Math.round(num(l.quantity) * num(l.unit_cost) * 100) / 100;\n  if (Math.abs(calc - num(l.line_total)) > 0.01) reasons.push(`Line \"${l.product}\" does not add up`);\n  sum += num(l.line_total);\n}\nsum = Math.round(sum * 100) / 100;\n\nconst expected = Math.round((sum - num(data.discount) + num(data.vat)) * 100) / 100;\nif (Math.abs(expected - num(data.total)) > 0.01) {\n  reasons.push(`Printed total ${num(data.total)} does not match lines (${expected})`);\n}\n\nfor (const f of ['supplier', 'invoice_number', 'invoice_date', 'currency', 'total']) {\n  if (data[f] === null || data[f] === undefined || data[f] === '') reasons.push(`Missing ${f}`);\n}\n\nreturn { json: { file: fileName, ...data, lines_sum: sum, expected_total: expected, needs_review: reasons.length > 0, review_reasons: reasons.join('; ') } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -256
      ],
